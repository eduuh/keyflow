# clangd LSP configuration
# Points editors (VS Code, Cursor, Neovim, etc.) at the cmake-generated
# compile_commands.json so includes resolve, type checking works, and
# IntelliSense isn't full of phantom errors.
#
# CMakeLists.txt already has CMAKE_EXPORT_COMPILE_COMMANDS=ON, so the file
# appears under builds/Debug/ after a configure. Run `./build.ps1 -Config
# Debug` once to generate it.

CompileFlags:
  CompilationDatabase: builds/Debug
  Add:
    - -std=c++17
    - -Wno-pragma-once-outside-header

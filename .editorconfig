root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C++ uses clang-format's 2-space style (see existing source files)
[*.{cpp,h,hpp}]
indent_size = 2

# JSON in this repo (config.json, package.json) is 2-space
[*.json]
indent_size = 2

# Markdown: keep trailing whitespace (it's significant for line breaks)
[*.md]
trim_trailing_whitespace = false

# PowerShell scripts use CRLF (Windows-native execution)
[*.ps1]
end_of_line = crlf

# YAML uses 2-space (GitHub Actions, configs)
[*.{yml,yaml}]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

{
  "version": "1.0",
  "name": "Custom Modifiers Example - Space Cadet Navigation",
  "strictMode": false,

  "remapping": {
    "CapsLock": "LeftShift"
  },

  "customModifiers": [
    {
      "key": "Space",
      "modifierName": "SPACE_MOD",
      "blockOutput": true
    }
  ],

  "layers": [
    {
      "name": "Space Cadet Navigation Layer",
      "trigger": "SPACE_MOD",
      "mappings": {
        "H": "Left",
        "J": "Down",
        "K": "Up",
        "L": "Right",
        "U": "Home",
        "I": "PageUp",
        "O": "PageDown",
        "P": "End",
        "Backspace": "Delete"
      }
    },
    {
      "name": "RALT Layer - Symbols",
      "trigger": "RALT",
      "mappings": {
        "1": "F1",
        "2": "F2",
        "3": "F3",
        "4": "F4",
        "5": "F5",
        "6": "F6",
        "7": "F7",
        "8": "F8",
        "9": "F9",
        "0": "F10",
        "Minus": "F11",
        "Equals": "F12"
      }
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keyboard Remapper Configuration",
  "description": "Configuration schema for keyboard remapping, layers, and combos",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Config file format version",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "description": "Configuration name (e.g., 'Colemak-DH', 'EDUUH_MOD')"
    },
    "strictMode": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, only explicitly mapped keys produce output. All unmapped keys are blocked. Useful for full keyboard remappings to prevent unmapped keys from leaking through."
    },
    "disableCapsLock": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, blocks the CapsLock key from reaching the OS, preventing accidental caps lock toggle. Useful when remapping CapsLock to another key (like Shift or Ctrl) to ensure the caps lock LED never activates."
    },
    "debug": {
      "type": "object",
      "description": "Debug and logging settings",
      "properties": {
        "debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging"
        },
        "showAllKeys": {
          "type": "boolean",
          "default": false,
          "description": "Log every keystroke"
        },
        "showPipeline": {
          "type": "boolean",
          "default": false,
          "description": "Log pipeline decisions"
        },
        "showTimings": {
          "type": "boolean",
          "default": false,
          "description": "Log performance metrics"
        }
      }
    },
    "remapping": {
      "type": "object",
      "description": "Simple 1-to-1 key remapping",
      "patternProperties": {
        "^[A-Za-z0-9_]+$": {
          "type": "string",
          "description": "Target key name"
        }
      },
      "additionalProperties": false
    },
    "noModCombos": {
      "type": "array",
      "description": "Key mappings that work without modifiers (e.g., number row → symbols)",
      "items": {
        "type": "object",
        "required": ["key", "output"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Source key (e.g., 'Grave', '1', '2')"
          },
          "output": {
            "type": "string",
            "description": "Output key (e.g., 'Slash', 'LeftBracket')"
          },
          "shift": {
            "type": "boolean",
            "default": false,
            "description": "Whether to send shift with output"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description (e.g., '` → ?')"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "description": "Layer definitions with modifier triggers",
      "items": {
        "type": "object",
        "required": ["name", "trigger", "mappings"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Layer name (e.g., 'Numpad Layer')"
          },
          "trigger": {
            "oneOf": [
              {
                "type": "string",
                "description": "Single trigger modifier (e.g., 'RALT', 'LCTRL')"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Multiple trigger modifiers (OR logic)"
              }
            ]
          },
          "mappings": {
            "type": "object",
            "description": "Key mappings within this layer",
            "patternProperties": {
              "^[A-Za-z0-9_]+$": {
                "type": "string"
              }
            }
          },
          "shiftMappings": {
            "type": "array",
            "description": "Mappings that output shift+key (for symbols)",
            "items": {
              "type": "object",
              "required": ["key", "output"],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Source key in this layer"
                },
                "output": {
                  "type": "string",
                  "description": "Output key (will be sent with Shift)"
                },
                "shift": {
                  "type": "boolean",
                  "default": true,
                  "description": "Send with shift modifier"
                },
                "description": {
                  "type": "string",
                  "description": "Description (e.g., '$ symbol')"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["version"]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-keyflow",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command", "while ($true) { $procs = Get-Process -Name keyflow -ErrorAction SilentlyContinue; if (-not $procs) { break }; $procs | ForEach-Object { try { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue } catch {} }; Start-Sleep -Milliseconds 200 }; exit 0"
            ]
        },
        {
            "label": "configure-cmake-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/builds/debug",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "configure-cmake-debug-ninja",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/builds/debug-ninja",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_C_COMPILER=cl",
                "-DCMAKE_CXX_COMPILER=cl"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build-keyflow-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/builds/debug",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "dependsOn": "configure-cmake-debug"
        },
        {
            "label": "build-keyflow-debug-ninja",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/builds/debug-ninja",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$msCompile"],
            "dependsOn": "configure-cmake-debug-ninja"
        },
        {
            "label": "pre-debug-keyflow",
            "dependsOn": [
                "kill-keyflow",
                "build-keyflow-debug"
            ],
            "dependsOrder": "sequence"
        }
    ]
}

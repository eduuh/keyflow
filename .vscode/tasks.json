{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-keyflow",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command", "while ($true) { $procs = Get-Process -Name keyflow -ErrorAction SilentlyContinue; if (-not $procs) { break }; $procs | ForEach-Object { try { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue } catch {} }; Start-Sleep -Milliseconds 200 }; exit 0"
            ]
        },
        {
            "label": "configure-cmake",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Visual Studio 17 2022",
                "-A",
                "x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build-keyflow-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "dependsOn": "configure-cmake"
        },
        {
            "label": "build-keyflow-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "dependsOn": "configure-cmake"
        },
        {
            "label": "pre-debug-keyflow",
            "dependsOn": [
                "kill-keyflow",
                "build-keyflow-debug"
            ],
            "dependsOrder": "sequence"
        }
    ]
}

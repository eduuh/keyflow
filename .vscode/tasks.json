{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-keyflow",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command", "while ($true) { $procs = Get-Process -Name keyflow -ErrorAction SilentlyContinue; if (-not $procs) { break }; $procs | ForEach-Object { try { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue } catch {} }; Start-Sleep -Milliseconds 200 }; exit 0"
            ]
        },
        {
            "label": "configure-cmake-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build/debug",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build-keyflow-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": "configure-cmake-debug"
        },
        {
            "label": "pre-debug-keyflow",
            "dependsOn": [
                "kill-keyflow",
                "build-keyflow-debug"
            ],
            "dependsOrder": "sequence"
        }
    ]
}
